{
  "expo": {
    "name": "DEWS",
    "slug": "ews-mobile",
    "version": "1.0.0",
    "scheme": "dews",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dews.ews",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "DEWS uses text-to-speech for alert announcements"
      }
    },
    "android": {
      "package": "com.dews.ews",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1e3a8a"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BATTERY_STATS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1e3a8a",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
